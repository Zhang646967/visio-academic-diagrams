{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "figure_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "use": {
      "enum": [
        "reading",
        "publication",
        "presentation"
      ]
    },
    "graph_type": {
      "enum": [
        "mindmap",
        "concept_map",
        "flowchart",
        "pipeline",
        "architecture",
        "evidence_map",
        "proof_map",
        "causal_dag",
        "swimlane",
        "timeline"
      ]
    },
    "detail_level": {
      "enum": [
        "overview",
        "method",
        "implementation"
      ]
    },
    "root_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "organizer",
              "topic",
              "concept",
              "claim",
              "assumption",
              "evidence",
              "start",
              "end",
              "process",
              "decision",
              "input_output",
              "subprocess",
              "data_store",
              "component",
              "annotation"
            ]
          },
          "item_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "support": {
            "enum": [
              "explicit",
              "inferred",
              "proposed",
              "unknown"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "label",
          "role",
          "item_ids",
          "support"
        ],
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "hierarchy",
              "control",
              "data",
              "dependency",
              "association",
              "causal",
              "message",
              "evidence"
            ]
          },
          "label": {
            "type": "string"
          },
          "source_relation_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "support": {
            "enum": [
              "explicit",
              "inferred",
              "proposed",
              "unknown"
            ]
          },
          "reverse_relation": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "from",
          "to",
          "kind",
          "label",
          "source_relation_ids",
          "support"
        ],
        "additionalProperties": true
      }
    },
    "must_keep_item_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "omissions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "item_id",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "caption": {
      "type": "string",
      "minLength": 1
    },
    "uncertainty_disclosure": {
      "type": "string"
    },
    "capability_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "paper_id",
    "figure_id",
    "title",
    "purpose",
    "use",
    "graph_type",
    "detail_level",
    "root_id",
    "nodes",
    "edges",
    "must_keep_item_ids",
    "omissions",
    "caption",
    "uncertainty_disclosure",
    "capability_ids"
  ],
  "additionalProperties": false,
  "$id": "urn:visio-academic-diagrams:figure-plan:1.0",
  "title": "Typed, source-linked figure plan; independent of geometry"
}
