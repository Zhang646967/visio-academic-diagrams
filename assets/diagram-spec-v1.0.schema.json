{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:visio-academic-diagrams:diagram-spec:1.0",
  "title": "Visio manual diagram design specification",
  "description": "Specification, not VSDX; journal/GUI checks are separate.",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "diagram_type",
    "environment",
    "canvas",
    "style",
    "publication",
    "nodes",
    "edges"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "diagram_type": {
      "enum": [
        "algorithm",
        "flowchart",
        "pipeline",
        "architecture",
        "dfd",
        "uml",
        "bpmn",
        "er",
        "methodology"
      ]
    },
    "environment": {
      "type": "object",
      "required": [
        "coordinate_origin",
        "pin",
        "drawing_scale"
      ],
      "properties": {
        "coordinate_origin": {
          "const": "bottom-left"
        },
        "pin": {
          "const": "center"
        },
        "drawing_scale": {
          "const": 1
        }
      },
      "additionalProperties": true
    },
    "canvas": {
      "type": "object",
      "required": [
        "width_mm",
        "height_mm",
        "margin_mm"
      ],
      "properties": {
        "width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "margin_mm": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "style": {
      "type": "object",
      "required": [
        "font_family",
        "font_pt",
        "line_pt"
      ],
      "properties": {
        "font_family": {
          "type": "string",
          "minLength": 1
        },
        "font_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "line_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "publication": {
      "type": "object",
      "required": [
        "final_width_mm",
        "uniform_scale"
      ],
      "properties": {
        "final_width_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "uniform_scale": {
          "const": true
        },
        "raster_dpi": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "quality": {
      "type": "object",
      "properties": {
        "min_final_font_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "min_final_line_pt": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": true
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[MAP][0-9]{2}$"
      },
      "uniqueItems": true
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "type",
          "x_mm",
          "y_mm",
          "width_mm",
          "height_mm"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "start",
              "end",
              "process",
              "decision",
              "input_output",
              "subprocess",
              "data_store",
              "component",
              "container",
              "annotation"
            ]
          },
          "x_mm": {
            "type": "number"
          },
          "y_mm": {
            "type": "number"
          },
          "width_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "height_mm": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "font_pt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "line_pt": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "angle_deg": {
            "const": 0
          }
        },
        "additionalProperties": true
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "points_mm": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "label_position_mm": {
            "type": "array",
            "prefixItems": [
              {
                "type": "number"
              },
              {
                "type": "number"
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          },
          "from_port": {
            "enum": [
              "north",
              "south",
              "east",
              "west",
              "auto"
            ]
          },
          "to_port": {
            "enum": [
              "north",
              "south",
              "east",
              "west",
              "auto"
            ]
          },
          "arrow": {
            "enum": [
              "end",
              "none",
              "both"
            ]
          },
          "route": {
            "enum": [
              "orthogonal",
              "straight"
            ]
          },
          "line_pt": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
